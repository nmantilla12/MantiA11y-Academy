@use 'variables';

// Reset básico y configuración base de accesibilidad
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: variables.$font-family-accessible;
  background-color: variables.$color-surface;
  color: variables.$color-on-surface;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

// Asegurar que los botones y elementos interactivos 
// utilicen los estilos base de foco definidos en el sistema
button, a, input, select, textarea {
  @include variables.focus-visible-style;
}

// Reset para listas
ul, ol {
  list-style: none;
}

// Mejora de accesibilidad para imágenes
img {
  max-width: 100%;
  display: block;
}
