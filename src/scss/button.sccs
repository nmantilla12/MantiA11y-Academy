.button {
  padding: 1rem 2rem;
  border-radius: $border-radius-lg;
  border: none;
  font-family: $font-family-accessible;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-block;
  text-decoration: none;

  &-primary {
    background-color: $color-primary;
    color: $color-on-primary; // Usamos la variable del sistema
  }

  &-secondary {
    background-color: transparent;
    border: 2px solid $color-primary;
    color: $color-primary;
  }

  &:hover {
    filter: brightness(1.2);
  }

  // Usamos el mixin del MTY-22 para consistencia en todo el proyecto
  @include focus-visible-style;
}